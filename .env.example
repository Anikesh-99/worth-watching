# Copy this file to `.env` (gitignored) and fill in from your Spotify app:
#   https://developer.spotify.com/dashboard  ->  your app  ->  Settings
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Optional — only if you use a different Redirect URI in your app settings.
# Must match EXACTLY what you registered.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
